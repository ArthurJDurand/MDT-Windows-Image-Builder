# ═══════════════════════════════════════════════════════════════════════════
# .gitattributes — MDT-Windows-Image-Builder
# ═══════════════════════════════════════════════════════════════════════════
#
# This repository ships build tooling, autounattend XML templates, and
# documentation. It does not ship Windows ISOs, WIMs, VM disks, or captured
# images. The rules below group by concern:
#
#   1. Default behavior
#   2. Windows text files (CRLF)
#   3. Cross-platform text files (LF)
#   4. Binary files (defensive — the repo should not contain any today)
#   5. Linguist classification
#   6. Export-ignore rules
#
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# 1. DEFAULT BEHAVIOR
# ───────────────────────────────────────────────────────────────────────────

* text=auto


# ───────────────────────────────────────────────────────────────────────────
# 2. WINDOWS TEXT FILES
# ───────────────────────────────────────────────────────────────────────────

*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.ps1xml    text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.xml       text eol=crlf
*.inf       text eol=crlf
*.txt       text eol=crlf


# ───────────────────────────────────────────────────────────────────────────
# 3. CROSS-PLATFORM TEXT FILES
# ───────────────────────────────────────────────────────────────────────────

*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf


# ───────────────────────────────────────────────────────────────────────────
# 4. BINARY FILES
# ───────────────────────────────────────────────────────────────────────────
# This repository should not contain binaries. The rules below are defensive:
# if a contributor accidentally commits one, Git will not mangle it.

*.exe        binary
*.msi        binary
*.msix       binary
*.msixbundle binary
*.appx       binary
*.appxbundle binary
*.cab        binary
*.msu        binary
*.dll        binary
*.sys        binary
*.cat        binary

*.zip        binary
*.rar        binary
*.7z         binary
*.tar        binary
*.gz         binary

*.iso        binary
*.wim        binary
*.esd        binary
*.swm        binary
*.vhd        binary
*.vhdx       binary
*.vmdk       binary
*.vdi        binary
*.ffu        binary

*.jpg        binary
*.jpeg       binary
*.png        binary
*.gif        binary
*.bmp        binary
*.ico        binary
*.svg        text eol=lf


# ───────────────────────────────────────────────────────────────────────────
# 5. LINGUIST CLASSIFICATION
# ───────────────────────────────────────────────────────────────────────────

docs/**       linguist-documentation
.github/**    linguist-documentation
README.md     linguist-documentation
CHANGELOG.md  linguist-documentation
CONTRIBUTING.md  linguist-documentation
CODE_OF_CONDUCT.md  linguist-documentation

autounattend/**  linguist-documentation


# ───────────────────────────────────────────────────────────────────────────
# 6. EXPORT-IGNORE RULES
# ───────────────────────────────────────────────────────────────────────────
# Developer-only files that do not belong in `git archive` output or
# GitHub's auto-generated source tarballs.

.github/          export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
tests/            export-ignore
CONTRIBUTING.md   export-ignore
CODE_OF_CONDUCT.md export-ignore
CHANGELOG.md      export-ignore


# ═══════════════════════════════════════════════════════════════════════════
# END OF .gitattributes
# ═══════════════════════════════════════════════════════════════════════════
